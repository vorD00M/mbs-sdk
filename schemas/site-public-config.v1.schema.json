{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://mbsplatform.online/schemas/site-public-config.v1.json",
 "type":"object","additionalProperties":false,
 "required":["format","installationId","siteId","releaseId","siteName","origin","host","localization","renderer","rendererDigest","assets","pages"],
 "properties":{
  "format":{"const":"mbs-site-public-config-v1"},
  "installationId":{"type":"string","format":"uuid"},"siteId":{"type":"string","format":"uuid"},"releaseId":{"type":"string","format":"uuid"},
  "siteName":{"type":"string","minLength":1,"maxLength":120},"origin":{"type":"string","format":"uri","maxLength":300},"host":{"type":"string","minLength":1,"maxLength":253},
  "localization":{"$ref":"site-localization.v1.schema.json"},
  "renderer":{"const":"mbs-public-adapter-v1"},"rendererDigest":{"$ref":"#/$defs/hash"},
  "assets":{"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["id","objectKey","sha256","mimeType","sizeBytes","width","height"],"properties":{
   "id":{"type":"string","format":"uuid"},"objectKey":{"$ref":"#/$defs/key"},"sha256":{"$ref":"#/$defs/hash"},"mimeType":{"enum":["image/jpeg","image/png","image/webp"]},"sizeBytes":{"type":"integer","minimum":1,"maximum":10485760},"width":{"type":"integer","minimum":1,"maximum":8192},"height":{"type":"integer","minimum":1,"maximum":8192}
  }}},
  "pages":{"type":"array","minItems":1,"maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["pageId","revision","locale","path","translationGroupId","title","description"],"properties":{
   "pageId":{"type":"string","format":"uuid"},"revision":{"type":"integer","minimum":1},"locale":{"type":"string","minLength":2,"maxLength":35},"path":{"type":"string","pattern":"^/","maxLength":2048},"translationGroupId":{"type":"string","format":"uuid"},"title":{"type":"string","maxLength":200},"description":{"type":"string","maxLength":500}
  }}}
 },
 "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"key":{"type":"string","minLength":1,"maxLength":1000,"pattern":"^[a-zA-Z0-9_/-][a-zA-Z0-9_./-]*$"}}
}

{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mbsplatform.online/schemas/page.v1.json",
 "type":"object","additionalProperties":false,
 "required":["schemaVersion","pageId","locale","seo","themeRef","layout"],
 "properties":{
  "schemaVersion":{"const":1},"pageId":{"type":"string","format":"uuid"},
  "locale":{"type":"string","pattern":"^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$","maxLength":35},
  "seo":{"type":"object","additionalProperties":false,"required":["title","description"],"properties":{"title":{"type":"string","maxLength":200},"description":{"type":"string","maxLength":500}}},
  "themeRef":{"type":"string","maxLength":200},
  "layout":{"type":"object","additionalProperties":false,"required":["id","type","regions"],"properties":{
   "id":{"type":"string","minLength":1,"maxLength":100},"type":{"const":"grid"},
   "regions":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["id","semantic","blocks"],"properties":{
    "id":{"type":"string","minLength":1,"maxLength":100},"semantic":{"type":"string","minLength":1,"maxLength":100},
    "blocks":{"type":"array","maxItems":500,"items":{"$ref":"#/$defs/block"}}
   }}}
  }}
 },
 "$defs":{"block":{"type":"object","additionalProperties":false,"required":["id","module","version","props"],"properties":{
  "id":{"type":"string","minLength":1,"maxLength":100},
  "module":{"type":"string","pattern":"^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$","maxLength":150},
  "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"props":{"type":"object"},
  "visibility":{"type":"object","additionalProperties":false,"required":["mobile","tablet","desktop"],"properties":{"mobile":{"type":"boolean"},"tablet":{"type":"boolean"},"desktop":{"type":"boolean"}}}
 }}}
}

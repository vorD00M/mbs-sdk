{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbsplatform.online/schemas/site-template.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "mbs-site-template-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$",
      "maxLength": 150
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "engineApi": {
      "const": "builder/v1"
    },
    "labels": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/labels"
    },
    "localization": {
      "$ref": "https://mbsplatform.online/schemas/site-localization.v1.json"
    },
    "themeRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 200
    },
    "shells": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "locale": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "maxLength": 35
          },
          "document": {
            "$ref": "https://mbsplatform.online/schemas/site-shell.v1.schema.json"
          }
        },
        "required": [
          "id",
          "revision",
          "locale",
          "document"
        ]
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pageId": {
            "type": "string",
            "format": "uuid"
          },
          "translationGroupId": {
            "type": "string",
            "format": "uuid"
          },
          "locale": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "maxLength": 35
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 2000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "document": {
            "$ref": "https://mbsplatform.online/schemas/page.v2.schema.json"
          }
        },
        "required": [
          "pageId",
          "translationGroupId",
          "locale",
          "path",
          "title",
          "document"
        ]
      }
    },
    "assets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*$",
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mimeType": {
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ]
          },
          "provenance": {
            "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/provenance"
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "mimeType",
          "provenance"
        ]
      }
    },
    "provenance": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/provenance"
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "engineApi",
    "labels",
    "localization",
    "themeRef",
    "shells",
    "pages",
    "assets",
    "provenance"
  ]
}

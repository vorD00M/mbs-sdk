{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbsplatform.online/schemas/design-library.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "mbs-design-library-v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1040,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^presets/[a-z-]+-[0-9]{3}-[0-9]+\\.[0-9]+\\.[0-9]+\\.json$",
            "maxLength": 160
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "files": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3200,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*$",
        "maxLength": 200
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "entries",
    "files"
  ]
}

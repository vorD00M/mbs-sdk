{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbsplatform.online/schemas/builder-common.v1.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$",
      "maxLength": 150
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "themeRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 200
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inherit": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "revision",
        "inherit"
      ]
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ru-RU": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            }
          },
          "required": [
            "title",
            "description"
          ]
        },
        "en-US": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            }
          },
          "required": [
            "title",
            "description"
          ]
        }
      },
      "required": [
        "ru-RU",
        "en-US"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceCategory": {
          "enum": [
            "original",
            "licensed",
            "system"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 1000
        }
      },
      "required": [
        "creator",
        "license",
        "createdAt",
        "sourceCategory"
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "enum": [
            "primary",
            "secondary",
            "accent",
            "background",
            "surface",
            "text",
            "muted",
            "border",
            "success",
            "warning",
            "error",
            "contrast"
          ]
        },
        "color": {
          "enum": [
            "primary",
            "secondary",
            "accent",
            "background",
            "surface",
            "text",
            "muted",
            "border",
            "success",
            "warning",
            "error",
            "contrast"
          ]
        },
        "borderColor": {
          "enum": [
            "primary",
            "secondary",
            "accent",
            "background",
            "surface",
            "text",
            "muted",
            "border",
            "success",
            "warning",
            "error",
            "contrast"
          ]
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 96
        },
        "gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 96
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "borderWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 240,
          "maximum": 1920
        },
        "width": {
          "enum": [
            "fluid",
            "boxed",
            "full-bleed"
          ]
        },
        "font": {
          "enum": [
            "system-sans",
            "system-serif",
            "humanist",
            "mono"
          ]
        },
        "fontSize": {
          "enum": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl",
            "3xl",
            "display"
          ]
        },
        "weight": {
          "enum": [
            400,
            500,
            600,
            700,
            800
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "between"
          ]
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ]
        },
        "shadow": {
          "enum": [
            "none",
            "subtle",
            "medium",
            "deep"
          ]
        },
        "sticky": {
          "enum": [
            "none",
            "top"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "position": {
          "enum": [
            "flow",
            "top-start",
            "top-end",
            "bottom-start",
            "bottom-end",
            "center"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rotate": {
          "type": "number",
          "minimum": -15,
          "maximum": 15
        },
        "scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        "zIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "motion": {
          "enum": [
            "none",
            "fade",
            "slide",
            "reveal"
          ]
        }
      },
      "required": []
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "layout": {
          "enum": [
            "1",
            "2-equal",
            "3-equal",
            "4-equal",
            "1/3+2/3",
            "2/3+1/3",
            "1/4+1/2+1/4",
            "sidebar-main",
            "main-sidebar"
          ]
        },
        "colSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "visible": {
          "type": "boolean"
        },
        "gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 96
        }
      },
      "required": []
    },
    "layoutNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            "semanticRole": {
              "enum": [
                "div",
                "section",
                "main",
                "header",
                "nav",
                "aside",
                "footer"
              ]
            },
            "style": {
              "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/style"
            },
            "responsive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "tablet": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "desktop": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                }
              },
              "required": []
            },
            "visibility": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "type": "boolean"
                },
                "tablet": {
                  "type": "boolean"
                },
                "desktop": {
                  "type": "boolean"
                }
              },
              "required": [
                "mobile",
                "tablet",
                "desktop"
              ]
            },
            "kind": {
              "enum": [
                "grid",
                "flex",
                "stack",
                "region",
                "layer"
              ]
            },
            "slot": {
              "enum": [
                "topper",
                "header",
                "navigation",
                "hero",
                "breadcrumb",
                "left-sidebar",
                "main",
                "right-sidebar",
                "footer",
                "floating"
              ]
            },
            "children": {
              "type": "array",
              "minItems": 0,
              "maxItems": 500,
              "items": {
                "$ref": "#/$defs/layoutNode"
              }
            }
          },
          "required": [
            "id",
            "kind",
            "children"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            "semanticRole": {
              "enum": [
                "div",
                "section",
                "main",
                "header",
                "nav",
                "aside",
                "footer"
              ]
            },
            "style": {
              "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/style"
            },
            "responsive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "tablet": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "desktop": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                }
              },
              "required": []
            },
            "visibility": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "type": "boolean"
                },
                "tablet": {
                  "type": "boolean"
                },
                "desktop": {
                  "type": "boolean"
                }
              },
              "required": [
                "mobile",
                "tablet",
                "desktop"
              ]
            },
            "kind": {
              "const": "module"
            },
            "module": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$",
              "maxLength": 150
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "props": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              }
            },
            "presetRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^mbs/[a-z-]+/[0-9]{3}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              },
              "required": [
                "id",
                "version"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "module",
            "version",
            "props"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            "semanticRole": {
              "enum": [
                "div",
                "section",
                "main",
                "header",
                "nav",
                "aside",
                "footer"
              ]
            },
            "style": {
              "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/style"
            },
            "responsive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "tablet": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "desktop": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                }
              },
              "required": []
            },
            "visibility": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "type": "boolean"
                },
                "tablet": {
                  "type": "boolean"
                },
                "desktop": {
                  "type": "boolean"
                }
              },
              "required": [
                "mobile",
                "tablet",
                "desktop"
              ]
            },
            "kind": {
              "const": "slot"
            },
            "slot": {
              "const": "main"
            }
          },
          "required": [
            "id",
            "kind",
            "slot"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            "semanticRole": {
              "enum": [
                "div",
                "section",
                "main",
                "header",
                "nav",
                "aside",
                "footer"
              ]
            },
            "style": {
              "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/style"
            },
            "responsive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "tablet": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "desktop": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                }
              },
              "required": []
            },
            "visibility": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "type": "boolean"
                },
                "tablet": {
                  "type": "boolean"
                },
                "desktop": {
                  "type": "boolean"
                }
              },
              "required": [
                "mobile",
                "tablet",
                "desktop"
              ]
            },
            "kind": {
              "const": "divider"
            }
          },
          "required": [
            "id",
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            "semanticRole": {
              "enum": [
                "div",
                "section",
                "main",
                "header",
                "nav",
                "aside",
                "footer"
              ]
            },
            "style": {
              "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/style"
            },
            "responsive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "tablet": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                },
                "desktop": {
                  "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/responsive"
                }
              },
              "required": []
            },
            "visibility": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mobile": {
                  "type": "boolean"
                },
                "tablet": {
                  "type": "boolean"
                },
                "desktop": {
                  "type": "boolean"
                }
              },
              "required": [
                "mobile",
                "tablet",
                "desktop"
              ]
            },
            "kind": {
              "const": "region-ref"
            },
            "regionRef": {
              "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/revision"
            }
          },
          "required": [
            "id",
            "kind",
            "regionRef"
          ]
        }
      ]
    },
    "inline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "marks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "enum": [
              "bold",
              "italic",
              "code"
            ]
          },
          "uniqueItems": true
        },
        "link": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pageId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "pageId"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "href": {
                  "type": "string",
                  "pattern": "^https?://[^\\s]+$",
                  "maxLength": 2048
                }
              },
              "required": [
                "href"
              ]
            }
          ]
        }
      },
      "required": [
        "text"
      ]
    },
    "richText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "paragraph",
                      "h2",
                      "h3",
                      "quote"
                    ]
                  },
                  "children": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 200,
                    "items": {
                      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/inline"
                    }
                  }
                },
                "required": [
                  "type",
                  "children"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "list"
                  },
                  "ordered": {
                    "type": "boolean"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "children": {
                          "type": "array",
                          "minItems": 0,
                          "maxItems": 200,
                          "items": {
                            "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/inline"
                          }
                        }
                      },
                      "required": [
                        "children"
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "ordered",
                  "items"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "version",
        "blocks"
      ]
    },
    "dataItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "category": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "imageAssetId": {
          "type": "string",
          "format": "uuid"
        },
        "targetPageId": {
          "type": "string",
          "format": "uuid"
        },
        "tags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 100
          }
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "static",
            "manualSelection"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/dataItem"
          }
        },
        "selection": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "items"
      ]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbsplatform.online/schemas/site-theme.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "mbs-site-theme-v1"
    },
    "siteId": {
      "type": "string",
      "format": "uuid"
    },
    "baseThemeRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 200
    },
    "tokens": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/tokens"
    }
  },
  "required": [
    "format",
    "siteId",
    "baseThemeRef",
    "tokens"
  ]
}

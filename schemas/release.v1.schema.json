{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mbsplatform.online/schemas/release.v1.json",
 "type":"object","additionalProperties":false,"required":["schemaVersion","releaseId","siteId","createdAt","pages","modules","assets"],
 "properties":{
  "schemaVersion":{"const":1},"releaseId":{"type":"string","format":"uuid"},"siteId":{"type":"string","format":"uuid"},"createdAt":{"type":"string","format":"date-time"},
  "pages":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["pageId","locale","path","objectKey","sha256"],"properties":{
   "pageId":{"type":"string","format":"uuid"},"locale":{"type":"string","maxLength":35},"path":{"type":"string","pattern":"^/"},"objectKey":{"$ref":"#/$defs/objectKey"},"sha256":{"$ref":"#/$defs/sha256"}
  }}},
  "modules":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","version","sha256"],"properties":{"id":{"type":"string"},"version":{"type":"string"},"sha256":{"$ref":"#/$defs/sha256"}}}},
  "assets":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["objectKey","sha256","mimeType","sizeBytes"],"properties":{"objectKey":{"$ref":"#/$defs/objectKey"},"sha256":{"$ref":"#/$defs/sha256"},"mimeType":{"type":"string"},"sizeBytes":{"type":"integer","minimum":0}}}}
 },
 "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"objectKey":{"type":"string","minLength":1,"maxLength":1000,"pattern":"^[a-zA-Z0-9_/-][a-zA-Z0-9_./-]*$"}}
}

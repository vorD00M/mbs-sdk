{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbsplatform.online/schemas/design-preset.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "mbs-design-preset-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^mbs/[a-z-]+/[0-9]{3}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "category": {
      "enum": [
        "topper",
        "header",
        "navigation",
        "hero",
        "breadcrumb",
        "layout",
        "left-sidebar",
        "right-sidebar",
        "footer",
        "cards",
        "carousel",
        "tabs",
        "accordion",
        "stepper",
        "pagination",
        "filter",
        "media",
        "content",
        "cta",
        "social"
      ]
    },
    "allowedSlots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "enum": [
          "topper",
          "header",
          "navigation",
          "hero",
          "breadcrumb",
          "left-sidebar",
          "main",
          "right-sidebar",
          "footer",
          "floating"
        ]
      },
      "uniqueItems": true
    },
    "moduleRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$",
            "maxLength": 150
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "required": [
          "id",
          "version"
        ]
      }
    },
    "labels": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/labels"
    },
    "layout": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/layoutNode"
    },
    "themeTokens": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/style"
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*$",
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "required": [
        "path",
        "sha256",
        "width",
        "height"
      ]
    },
    "provenance": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/provenance"
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "category",
    "allowedSlots",
    "moduleRefs",
    "labels",
    "layout",
    "thumbnail",
    "provenance"
  ]
}

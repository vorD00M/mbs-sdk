{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbsplatform.online/schemas/theme-pack.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "mbs-theme-pack-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$",
      "maxLength": 150
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "labels": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/labels"
    },
    "tokens": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/tokens"
    },
    "provenance": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/provenance"
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "labels",
    "tokens",
    "provenance"
  ]
}

{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mbsplatform.online/schemas/site-localization.v1.json",
 "type":"object","additionalProperties":false,
 "required":["schemaVersion","mode","defaultLocale","locales","routing","missingTranslationPolicy"],
 "properties":{
  "schemaVersion":{"const":1},"mode":{"enum":["SINGLE","MULTI"]},"defaultLocale":{"$ref":"#/$defs/locale"},
  "locales":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/locale"}},
  "missingTranslationPolicy":{"const":"OMIT"},
  "routing":{"type":"object","additionalProperties":false,"required":["strategy"],"properties":{"strategy":{"enum":["NONE","SUBPATH"]},"defaultLocalePrefix":{"type":"boolean"}}}
 },
 "allOf":[
  {"if":{"properties":{"mode":{"const":"SINGLE"}}},"then":{"properties":{"locales":{"maxItems":1},"routing":{"properties":{"strategy":{"const":"NONE"},"defaultLocalePrefix":{"const":false}}}}}},
  {"if":{"properties":{"mode":{"const":"MULTI"}}},"then":{"properties":{"locales":{"minItems":2},"routing":{"properties":{"strategy":{"const":"SUBPATH"}}}}}}
 ],
 "$defs":{"locale":{"type":"string","minLength":2,"maxLength":63,"pattern":"^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"}}
}

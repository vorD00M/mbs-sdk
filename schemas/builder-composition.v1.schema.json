{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbsplatform.online/schemas/builder-composition.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "mbs-builder-composition-v1"
    },
    "themePack": {
      "$ref": "https://mbsplatform.online/schemas/theme-pack.v1.schema.json"
    },
    "siteTheme": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "document": {
              "$ref": "https://mbsplatform.online/schemas/site-theme.v1.schema.json"
            }
          },
          "required": [
            "id",
            "revision",
            "document"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "siteShell": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "document": {
              "$ref": "https://mbsplatform.online/schemas/site-shell.v1.schema.json"
            }
          },
          "required": [
            "id",
            "revision",
            "document"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "regions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "document": {
            "$ref": "https://mbsplatform.online/schemas/region.v1.schema.json"
          }
        },
        "required": [
          "id",
          "revision",
          "document"
        ]
      }
    }
  },
  "required": [
    "format",
    "themePack",
    "siteTheme",
    "siteShell",
    "regions"
  ]
}

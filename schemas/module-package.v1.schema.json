{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://mbsplatform.online/schemas/module-package.v1.json",
 "type":"object","additionalProperties":false,
 "required":["format","id","version","engineApi","renderKind","propsSchema","defaultProps","capabilities","entry","styles","dependencies","ssr","hydration","artifactDigest","status","trust"],
 "properties":{
  "format":{"const":"mbs-module-package-v1"},"id":{"type":"string","pattern":"^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "engineApi":{"const":"core/v1"},"renderKind":{"const":"react"},"propsSchema":{"type":"object"},"defaultProps":{"type":"object"},
  "capabilities":{"type":"array","uniqueItems":true,"items":{"enum":["responsive","ssr","preview"]}},
  "entry":{"type":"string","pattern":"^builtin:"},"styles":{"type":"array","items":{"type":"string","pattern":"^builtin:"}},
  "dependencies":{"type":"array","maxItems":0},"ssr":{"const":true},"hydration":{"const":"none"},"artifactDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"status":{"const":"builtin"},"trust":{"const":"compiled-in"}
 }
}

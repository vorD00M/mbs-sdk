{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbsplatform.online/schemas/module-package.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "version",
    "engineApi",
    "renderKind",
    "propsSchema",
    "defaultProps",
    "capabilities",
    "entry",
    "styles",
    "dependencies",
    "ssr",
    "hydration",
    "artifactDigest",
    "status",
    "trust",
    "allowedSlots",
    "islands",
    "labels"
  ],
  "properties": {
    "format": {
      "const": "mbs-module-package-v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "engineApi": {
      "const": "builder/v1"
    },
    "renderKind": {
      "const": "react"
    },
    "propsSchema": {
      "type": "object"
    },
    "defaultProps": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "responsive",
          "ssr",
          "preview",
          "client-islands"
        ]
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^builtin:"
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^builtin:"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 0
    },
    "ssr": {
      "const": true
    },
    "hydration": {
      "enum": [
        "none",
        "islands"
      ]
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "const": "builtin"
    },
    "trust": {
      "const": "compiled-in"
    },
    "allowedSlots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "topper",
          "header",
          "navigation",
          "hero",
          "breadcrumb",
          "left-sidebar",
          "main",
          "right-sidebar",
          "footer",
          "floating"
        ]
      }
    },
    "islands": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "navigation",
          "carousel",
          "tabs",
          "collection",
          "form"
        ]
      }
    },
    "labels": {
      "$ref": "https://mbsplatform.online/schemas/builder-common.v1.schema.json#/$defs/labels"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "hydration": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "islands": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "islands": {
            "type": "array",
            "minItems": 1
          },
          "capabilities": {
            "type": "array",
            "contains": {
              "const": "client-islands"
            }
          }
        }
      }
    }
  ]
}
